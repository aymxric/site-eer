<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Révisions Terminale — Maths & Physique</title>
<style>
/* ── TOKENS ─────────────────────────────────────────── */
:root {
  --ink:       #0f0f11;
  --ink2:      #3a3a46;
  --ink3:      #7a7a8e;
  --paper:     #fafaf8;
  --surface:   #ffffff;
  --rule:      #e8e8ee;

  --math-h:    #1e3a5f;   /* bleu nuit */
  --math-a:    #2563eb;   /* bleu vif */
  --math-bg:   #eff5ff;

  --phys-h:    #1f3a2e;   /* vert forêt */
  --phys-a:    #16a34a;   /* vert vif */
  --phys-bg:   #f0faf3;

  --ok-bg:     #d1fae5; --ok-txt: #065f46;
  --ko-bg:     #fee2e2; --ko-txt: #991b1b;

  --r: 12px; --r-sm: 7px;
  --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

/* ── RESET ───────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font);
  background: var(--paper);
  color: var(--ink);
  min-height: 100dvh;
  font-size: 15px;
  line-height: 1.5;
}

/* ── TOP BAR ─────────────────────────────────────────── */
.topbar {
  background: var(--ink);
  color: #fff;
  padding: .9rem 1.25rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  position: sticky;
  top: 0;
  z-index: 200;
}
.topbar-title { font-size: 15px; font-weight: 700; letter-spacing: .02em; }
.topbar-sub   { font-size: 12px; opacity: .55; margin-left: auto; }
.prog-pill {
  background: rgba(255,255,255,.15);
  border-radius: 30px;
  padding: 3px 10px;
  font-size: 12px;
  white-space: nowrap;
}

/* ── HOME ────────────────────────────────────────────── */
.home { padding: 1.5rem 1.25rem; }

.hero-strip {
  background: var(--ink);
  border-radius: var(--r);
  padding: 1.75rem 1.5rem;
  color: #fff;
  margin-bottom: 1.5rem;
  position: relative;
  overflow: hidden;
}
.hero-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 30px,
    rgba(255,255,255,.03) 30px,
    rgba(255,255,255,.03) 31px
  );
}
.hero-eyebrow { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .5; margin-bottom: .5rem; }
.hero-h { font-size: 26px; font-weight: 800; line-height: 1.15; margin-bottom: .5rem; }
.hero-p { font-size: 13px; opacity: .65; line-height: 1.6; }
.hero-stats { display: flex; gap: 1.5rem; margin-top: 1.25rem; }
.stat-item .val { font-size: 22px; font-weight: 800; }
.stat-item .lbl { font-size: 11px; opacity: .55; }

.subject-cards { display: grid; grid-template-columns: 1fr 1fr; gap: .875rem; margin-bottom: 1.5rem; }
.subject-card {
  border-radius: var(--r);
  padding: 1.25rem;
  cursor: pointer;
  transition: transform .15s, box-shadow .15s;
  border: 1.5px solid transparent;
}
.subject-card:active { transform: scale(.97); }
.subject-card.math { background: var(--math-bg); border-color: #c7d9f8; }
.subject-card.phys { background: var(--phys-bg); border-color: #b3dfc2; }
.sc-icon { font-size: 28px; margin-bottom: .625rem; display: block; }
.sc-name { font-size: 14px; font-weight: 700; margin-bottom: .2rem; }
.sc-name.math { color: var(--math-h); }
.sc-name.phys { color: var(--phys-h); }
.sc-sub { font-size: 12px; color: var(--ink3); }
.sc-count { font-size: 11px; font-weight: 700; margin-top: .625rem; padding: 2px 7px; border-radius: 20px; display: inline-block; }
.sc-count.math { background: var(--math-bg); color: var(--math-a); border: 1px solid #93b8f5; }
.sc-count.phys { background: var(--phys-bg); color: var(--phys-a); border: 1px solid #86c99d; }

.section-title {
  font-size: 11px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink3);
  margin-bottom: .75rem;
}

.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
.quick-card {
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: var(--r);
  padding: 1rem;
  cursor: pointer;
  transition: border-color .15s;
}
.quick-card:hover { border-color: var(--ink3); }
.qc-label { font-size: 13px; font-weight: 600; margin-bottom: .2rem; }
.qc-sub { font-size: 12px; color: var(--ink3); }
.qc-badge {
  font-size: 10px; font-weight: 700; padding: 2px 7px;
  border-radius: 20px; margin-top: .5rem; display: inline-block;
}
.badge-math { background: var(--math-bg); color: var(--math-a); }
.badge-phys { background: var(--phys-bg); color: var(--phys-a); }

/* ── SUBJECT PAGE ────────────────────────────────────── */
.subject-page { display: none; }
.subject-page.active { display: block; }

.sp-header {
  padding: 1.5rem 1.25rem 0;
  display: flex;
  align-items: center;
  gap: .75rem;
  margin-bottom: 1rem;
}
.back-btn {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1.5px solid var(--rule);
  background: var(--surface);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; font-size: 18px; flex-shrink: 0;
  transition: background .15s;
}
.back-btn:hover { background: var(--paper); }
.sp-header-text h2 { font-size: 18px; font-weight: 800; }
.sp-header-text p  { font-size: 12px; color: var(--ink3); }

.sp-tabs {
  display: flex;
  border-bottom: 1.5px solid var(--rule);
  padding: 0 1.25rem;
  gap: 0;
  margin-bottom: 1.25rem;
}
.sp-tab {
  padding: .625rem 1rem;
  font-size: 13px; font-weight: 600;
  cursor: pointer;
  border-bottom: 2.5px solid transparent;
  color: var(--ink3);
  background: none;
  border-top: none; border-left: none; border-right: none;
  font-family: var(--font);
  transition: color .15s;
  margin-bottom: -1.5px;
}
.sp-tab.active.math { color: var(--math-a); border-bottom-color: var(--math-a); }
.sp-tab.active.phys { color: var(--phys-a); border-bottom-color: var(--phys-a); }
.sp-tab:not(.active):hover { color: var(--ink2); }

.sp-content { padding: 0 1.25rem 2rem; }
.tab-pane { display: none; }
.tab-pane.active { display: block; }

/* ── FICHES ──────────────────────────────────────────── */
.fiche {
  border-radius: var(--r);
  border: 1.5px solid var(--rule);
  background: var(--surface);
  margin-bottom: .75rem;
  overflow: hidden;
}
.fiche-header {
  padding: .875rem 1rem;
  font-size: 14px; font-weight: 700;
  cursor: pointer;
  display: flex; align-items: center; justify-content: space-between;
  user-select: none;
  transition: background .1s;
}
.fiche-header:hover { background: var(--paper); }
.fiche-header .chev { font-size: 12px; color: var(--ink3); transition: transform .2s; }
.fiche.open .fiche-header .chev { transform: rotate(180deg); }
.fiche-body {
  display: none;
  padding: 0 1rem 1rem;
  border-top: 1px solid var(--rule);
}
.fiche.open .fiche-body { display: block; }
.fiche-body p { font-size: 13px; color: var(--ink2); line-height: 1.7; margin-top: .75rem; }
.fiche-body ul { padding-left: 1.1rem; margin-top: .4rem; }
.fiche-body li { font-size: 13px; color: var(--ink2); line-height: 1.7; margin-bottom: .2rem; }
.fiche-body strong { color: var(--ink); }
.formula {
  font-family: 'Courier New', monospace;
  font-size: 13px;
  padding: .5rem .875rem;
  border-radius: var(--r-sm);
  margin: .5rem 0;
  line-height: 1.5;
}
.formula.math { background: var(--math-bg); border-left: 3px solid var(--math-a); color: var(--math-h); }
.formula.phys { background: var(--phys-bg); border-left: 3px solid var(--phys-a); color: var(--phys-h); }

/* ── QCM ─────────────────────────────────────────────── */
.qcm-toolbar {
  display: flex; align-items: center; gap: .625rem;
  margin-bottom: 1rem; flex-wrap: wrap;
}
.qcm-toolbar label { font-size: 13px; color: var(--ink3); }
.qcm-toolbar select {
  padding: 6px 10px;
  border: 1.5px solid var(--rule);
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--ink);
  font-family: var(--font); font-size: 13px;
  cursor: pointer;
}
.btn {
  padding: 7px 16px;
  border-radius: var(--r-sm);
  font-family: var(--font); font-size: 13px; font-weight: 600;
  cursor: pointer; border: 1.5px solid transparent;
  transition: opacity .15s, transform .1s;
}
.btn:active { transform: scale(.97); }
.btn-math { background: var(--math-a); color: #fff; border-color: var(--math-a); }
.btn-phys { background: var(--phys-a); color: #fff; border-color: var(--phys-a); }

.score-strip {
  border-radius: var(--r);
  padding: .875rem 1rem;
  margin-bottom: 1rem;
  display: flex; align-items: center; gap: 1rem;
  display: none;
}
.score-strip.math { background: var(--math-bg); }
.score-strip.phys { background: var(--phys-bg); }
.score-big { font-size: 28px; font-weight: 800; }
.score-big.math { color: var(--math-a); }
.score-big.phys { color: var(--phys-a); }
.score-info { font-size: 13px; color: var(--ink2); }
.score-info span { font-weight: 700; }

.qitem {
  background: var(--surface);
  border: 1.5px solid var(--rule);
  border-radius: var(--r);
  padding: 1.1rem;
  margin-bottom: .75rem;
}
.qitem-q { font-size: 14px; font-weight: 600; line-height: 1.5; margin-bottom: .875rem; }
.qnum { font-weight: 400; color: var(--ink3); margin-right: .3rem; }
.opts { display: flex; flex-direction: column; gap: 6px; }
.opt {
  padding: .6rem .875rem;
  border-radius: var(--r-sm);
  border: 1.5px solid var(--rule);
  background: var(--surface);
  color: var(--ink);
  font-family: var(--font); font-size: 13px;
  text-align: left; cursor: pointer;
  transition: border-color .12s, background .12s;
}
.opt:hover:not(:disabled) { border-color: var(--ink3); background: var(--paper); }
.opt:disabled { cursor: default; }
.opt.correct { background: var(--ok-bg); border-color: #34d399; color: var(--ok-txt); font-weight: 600; }
.opt.wrong   { background: var(--ko-bg); border-color: #f87171; color: var(--ko-txt); }
.fb {
  font-size: 12px; line-height: 1.55;
  border-radius: var(--r-sm);
  padding: .5rem .75rem;
  margin-top: .625rem;
  display: none;
}
.fb.ok { background: var(--ok-bg); color: var(--ok-txt); }
.fb.ko { background: var(--ko-bg); color: var(--ko-txt); }

/* ── FORMULAS PAGE ───────────────────────────────────── */
.formula-grid { display: grid; gap: .5rem; }

/* ── RESPONSIVE ──────────────────────────────────────── */
@media (max-width: 380px) {
  .subject-cards { grid-template-columns: 1fr; }
  .quick-grid { grid-template-columns: 1fr; }
  .hero-stats { gap: 1rem; }
}
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
  <div class="topbar-title">📚 Terminale Générale</div>
  <div class="prog-pill" id="topbar-prog">0 réponses</div>
</div>

<!-- ══════════ HOME ══════════ -->
<div id="page-home" class="home">

  <div class="hero-strip">
    <div class="hero-eyebrow">Baccalauréat Général 2025</div>
    <div class="hero-h">Maths &amp;<br>Physique-Chimie</div>
