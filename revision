// ─── ÉTAT GLOBAL ───────────────────────────────
var G = { math: {a:0,c:0,t:0}, phys: {a:0,c:0,t:0} };

// ─── NAVIGATION ────────────────────────────────
function goHome() {
  document.getElementById('page-home').style.display = 'block';
  document.querySelectorAll('.subject-page').forEach(function(p){ p.classList.remove('active'); });
}
function openSubject(subj) {
  document.getElementById('page-home').style.display = 'none';
  document.querySelectorAll('.subject-page').forEach(function(p){ p.classList.remove('active'); });
  document.getElementById('page-' + subj).classList.add('active');
  window.scrollTo(0,0);
}
function switchTab(subj, tab) {
  var page = document.getElementById('page-' + subj);
  page.querySelectorAll('.sp-tab').forEach(function(t){ t.classList.remove('active'); });
  page.querySelectorAll('.tab-pane').forEach(function(p){ p.classList.remove('active'); });
  // activer l'onglet
  page.querySelectorAll('.sp-tab').forEach(function(t){
    if (t.getAttribute('onclick') === "switchTab('" + subj + "','" + tab + "')") t.classList.add('active');
  });
  var tp = document.getElementById(subj + '-' + tab);
  if (tp) tp.classList.add('active');
  window.scrollTo(0,0);
}

// ─── ACCORDÉON ─────────────────────────────────
function toggleFiche(header) {
  header.parentElement.classList.toggle('open');
}

// ─── QCM ───────────────────────────────────────
function shuffle(arr) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}

function startQCM(subj) {
  var nbEl = document.getElementById(subj + '-nb');
  var nb = Math.min(parseInt(nbEl.value), QCM[subj].length);
  var pool = shuffle(QCM[subj]).slice(0, nb);

  G[subj] = { a: 0, c: 0, t: pool.length };
  updateScore(subj);

  var strip = document.getElementById(subj + '-score-strip');
  strip.style.display = 'flex';

  var container = document.getElementById(subj + '-questions');
  container.innerHTML = '';

  pool.forEach(function(q, qi) {
    // mélanger les options
    var origIdxs = q.opts.map(function(_, i){ return i; });
    var shuffled = shuffle(origIdxs);
    var newAns = shuffled.indexOf(q.ans);

    var optsHtml = shuffled.map(function(oi, ni) {
      return '<button class="opt" data-ni="' + ni + '" onclick="answer(this,\'' + subj + '\',' + newAns + ',' + pool.length + ',' + qi + ')">' + q.opts[oi] + '</button>';
    }).join('');

    var div = document.createElement('div');
    div.className = 'qitem';
    div.innerHTML =
      '<div class="qitem-q"><span class="qnum">Q' + (qi+1) + '.</span>' + q.q + '</div>' +
      '<div class="opts" data-exp="' + encodeURIComponent(q.exp) + '">' + optsHtml + '</div>' +
      '<div class="fb" id="fb-' + subj + '-' + qi + '"></div>';
    container.appendChild(div);
  });

  container.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function answer(btn, subj, correctNI, total, qi) {
  var opts = btn.parentElement;
  if (opts.querySelector('.opt[disabled]')) return;

  var chosen = parseInt(btn.getAttribute('data-ni'));
  var ok = chosen === correctNI;
  var exp = decodeURIComponent(opts.getAttribute('data-exp'));

  opts.querySelectorAll('.opt').forEach(function(o) {
    o.disabled = true;
    var ni = parseInt(o.getAttribute('data-ni'));
    if (ni === correctNI) o.classList.add('correct');
    else if (o === btn && !ok) o.classList.add('wrong');
  });

  var fb = document.getElementById('fb-' + subj + '-' + qi);
  fb.style.display = 'block';
  fb.className = 'fb ' + (ok ? 'ok' : 'ko');
  fb.textContent = (ok ? '✓ Correct ! ' : '✗ Incorrect. ') + exp;

  G[subj].a++;
  if (ok) G[subj].c++;
  updateScore(subj);
  updateTopbar();
}

function updateScore(subj) {
  var bigEl = document.getElementById(subj + '-score-big');
  var pctEl = document.getElementById(subj + '-pct');
  if (bigEl) bigEl.textContent = G[subj].c + '/' + G[subj].t;
  var pct = G[subj].a > 0 ? Math.round(G[subj].c / G[subj].a * 100) : 0;
  if (pctEl) pctEl.textContent = pct;
}
function updateTopbar() {
  var total = G.math.a + G.phys.a;
  document.getElementById('topbar-prog').textContent = total + ' réponse' + (total > 1 ? 's' : '');
  document.getElementById('stat-rep').textContent = total;
}
